{
  "name": "trace-viewer2",
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "start": "bash ./scripts/start.sh",
    "dev": "concurrently \"npm run server:dev\" \"vite\"",
    "server:dev": "nodemon --watch src/server --ext ts --exec \"tsx src/server/index.ts\"",
    "server": "tsx src/server/index.ts",
    "build": "tsc && vite build",
    "build:icon": "bash scripts/make-macos-icon.sh",
    "build:electron": "npm run build && node scripts/build-electron.mjs",
    "app:dev": "npm run build:electron && electron .",
    "app:build": "npm run build:icon && npm run build:electron && electron-builder --mac --dir",
    "app:dist": "npm run build:icon && npm run build:electron && electron-builder --mac",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.traceviewer.app",
    "productName": "Trace Viewer",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ]
    }
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
